#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Скрипт сессии в стиле SteamOS gamescope-session: поднимает pipewire,
# kwin-wayland внутри gamescope, затем Big Picture. При падении — возврат
# в recovery UI (как steam-deck-session.service в SteamOS).
set -eu
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"; chown "$(id -un)" "$XDG_RUNTIME_DIR"

pipewire & PW=$!
wireplumber & WP=$!
trap 'kill $PW $WP 2>/dev/null || true' EXIT

exec /usr/local/bin/deck-steam-launch
