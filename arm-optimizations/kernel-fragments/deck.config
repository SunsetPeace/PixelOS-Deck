# Конфиг-фрагмент ядра для targetfs. Вливается scripts/kconfig/merge_config.sh
# поверх gki_defconfig/msm-4.9 в build-boot.sh.
CONFIG_EROFFS=y
CONFIG_EROFFS_LZ4C=y
CONFIG_F2FS_FS=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_USERFAULTFD=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_MSM_KGSL=y
CONFIG_QCOM_SMEM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_SCHED_WALT=n
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
