# SPDX-License-Identifier: GPL-3.0-only
[Unit]
Description=ZRAM swap tuned for 2 GiB LPDDR4x (Pixel 3)
DefaultDependencies=no
Before=swap.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo ${ZRAM_BYTES:-2147483648} > /sys/block/zram0/disksize; \
  mkswap /dev/zram0 >/dev/null; swapon -p 32767 /dev/zram0'
